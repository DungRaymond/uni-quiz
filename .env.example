# All environments require Supabase. SUPABASE_URL is also supported server-side.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate a private random value, at least 32 bytes. Never prefix with NEXT_PUBLIC_.
QUIZ_SIGNING_SECRET=
# Optional: only needed for anonymous-access verification, never used for admin writes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
